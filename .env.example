# Grocery Optimizer - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION (Neon.tech PostgreSQL + TimescaleDB)
# ============================================================================
# Get this from your Neon.tech project dashboard
# Format: postgresql://username:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/groceryoptimizer

# ============================================================================
# REDIS CONFIGURATION (Upstash Redis)
# ============================================================================
# Get this from your Upstash Redis console
# Format: redis://default:password@host:port
REDIS_URL=redis://default:password@region-xxx.upstash.io:6379
REDIS_ENABLED=False

# ============================================================================
# HUGGING FACE API (for AI Models)
# ============================================================================
# Get your API token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# OLLAMA CONFIGURATION (Local LLM Server)
# ============================================================================
# URL for your Ollama server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama models to use
OLLAMA_CHEF_MODEL=smollm:1.7b
OLLAMA_SOUS_CHEF_MODEL=smollm:360m
OLLAMA_NUTRITIONIST_MODEL=smollm:360m

# ============================================================================
# MLFLOW TRACKING (Experiment Tracking)
# ============================================================================
# URL for MLflow tracking server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=grocery-meal-planner

# Or use a remote MLflow server
# MLFLOW_TRACKING_URI=https://your-mlflow-server.com

# ============================================================================
# DEAL INGESTION (FLIPP FLYER SEARCH)
# ============================================================================
# RETIRED: FLIPP_API_KEY / FLIPP_API_URL.
#
# There is no Flipp API behind them. FLIPP_API_KEY was never anything but this
# file's own placeholder ("your_flipp_api_key_here"), https://api.flipp.com/v2
# does not correspond to any documented Flipp product, and no code ever read
# either value. Both settings are gone from app/config.py. Leaving them in a
# local .env is harmless (Settings uses extra="ignore"), but they do nothing.
#
# What ingestion actually uses is https://backflipp.wishabi.com/flipp/items/search
# -- the keyless JSON backend behind flipp.com's own search box. It needs no
# credentials. It is also UNSANCTIONED: undocumented, unlicensed, no SLA, no
# published rate limit, and Flipp may block it at any time. Read
# app/services/flipp_client.py before enabling anything here.

# Master switch. Off means no network call is ever made and
# POST /postal-code/refresh returns 503. Apply migrations/001-003 before
# turning it on, or every INSERT fails on an unknown column.
DEAL_INGESTION_ENABLED=false

# ----------------------------------------------------------------------------
# ALLERGEN-SAFETY GATE -- read app/services/deal_gate.py before changing.
# ----------------------------------------------------------------------------
# false (default): users with ANY dietary restriction are served only curated
# deals, never machine-ingested ones.
#
# Why: app/agents/dietary.py decides dietary compliance by casefold SUBSTRING
# match over a fixed vocabulary. That is sound against the hand-written seed
# catalog and unsound against raw flyer product names, in the dangerous
# direction -- "prosciutto", "chorizo", "kielbasa", "gelatin", "lard" and
# "marzipan" contain no forbidden term, so a nut-free or vegetarian meal plan
# built from ingested deals can include them.
#
# This is a KNOWN, ACCEPTED gap with the fix deliberately deferred (the fix is
# token-boundary matching plus a products table with a real allergen
# taxonomy). Setting this to true accepts allergen risk on your users' behalf.
# It is not a performance knob. Do not set it until dietary.py is fixed.
INGESTED_DEALS_FOR_RESTRICTED_DIETS=false

# ----------------------------------------------------------------------------
# Politeness. Defaults are fine; they exist so they can be made gentler, not
# more aggressive. This endpoint owes us nothing.
# ----------------------------------------------------------------------------
# FLIPP_SEARCH_URL=https://backflipp.wishabi.com/flipp/items/search
# FLIPP_TIMEOUT_SECONDS=10.0
# FLIPP_MAX_RETRIES=2
# Minimum seconds between requests, enforced inside the client.
# FLIPP_MIN_REQUEST_INTERVAL=1.5
# FLIPP_USER_AGENT=grocery-optimizer/0.1 (personal meal-planning project)
#
# Ingestion coverage is exactly the staple terms in
# app/services/flipp_staples.py -- one request per term per postal code,
# because the endpoint is search-by-term only and a flyer cannot be
# enumerated. That file is where you change what gets ingested.
# There is NO scheduler: refresh via POST /postal-code/refresh or
# scripts/ingest_deals.py, once a week when flyers turn over.

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=True

# Secret key for JWT tokens and session management
SECRET_KEY=your-secret-key-change-this-in-production

# API rate limiting
API_RATE_LIMIT=100  # requests per minute

# ============================================================================
# CELERY CONFIGURATION (Background Tasks)
# ============================================================================
# Broker URL (uses Upstash Redis)
CELERY_BROKER_URL=redis://default:password@region-xxx.upstash.io:6379
CELERY_RESULT_BACKEND=redis://default:password@region-xxx.upstash.io:6379

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============================================================================
# GITHUB CODESPACES (auto-detected)
# ============================================================================
# These are automatically set by GitHub Codespaces
# CODESPACES=true
# CODESPACE_NAME=your-codespace-name

# ============================================================================
# COST TRACKING
# ============================================================================
# Enable detailed cost tracking for API calls
ENABLE_COST_TRACKING=true

# Cost per 1M tokens for different models (USD)
COST_SMOLLM_1_7B=0.001
COST_SMOLLM_360M=0.0005
COST_SMOLLM_135M=0.0002

# ============================================================================
# CACHING SETTINGS
# ============================================================================
# Cache TTL in seconds
CACHE_TTL_DEALS=21600        # 6 hours
CACHE_TTL_RECIPES=86400       # 24 hours
CACHE_TTL_STORES=604800       # 7 days

# ============================================================================
# TESTING
# ============================================================================
# Use separate test database for running tests
TEST_DATABASE_URL=postgresql://user:password@host/groceryoptimizer_test
